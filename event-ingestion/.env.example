# Copy to .env and fill in what you need. Everything is optional; defaults work out of the box.

# --- Collection --------------------------------------------------------------------------------------
# How many days ahead to collect.
HORIZON_DAYS=90
# Seconds between uncached requests to the same site (be polite).
REQUEST_INTERVAL_S=0.5
# Fetch each UMD calendar event page once (cached 2 days) for venue/ticket/host details.
UMD_CALENDAR_FETCH_DETAILS=true
# Free key from https://developer.ticketmaster.com/ (Ticketmaster is skipped without it).
TICKETMASTER_API_KEY=
TICKETMASTER_RADIUS_MILES=10
# Geocode unknown street addresses with OpenStreetMap Nominatim (cached). Set to "none" to disable.
GEOCODER=nominatim

# --- Optional local LLM tagging (free, open source, via https://ollama.com) ----------------------------
# ollama pull qwen2.5:3b   then   LLM_TAGGING=true  (or pass --llm-tags)
LLM_TAGGING=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_MAX_EVENTS_PER_RUN=200

# --- Snowflake (only for `umd-events load-snowflake`) ------------------------------------------------
# Account identifier looks like ORGNAME-ACCOUNTNAME (Snowsight: bottom-left menu > account > "Copy account identifier").
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# One of: password, key-pair file, or browser SSO (default when neither is set).
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_AUTHENTICATOR=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=UMD_EVENTS
SNOWFLAKE_SCHEMA=PUBLIC

# --- API -------------------------------------------------------------------------------------------
API_CORS_ORIGINS=*
